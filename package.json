{
  "name": "verdant-pokemon-rogue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "import:pokemon": "node scripts/import-pokemon.mjs",
    "simulate": "vite-node scripts/simulate.ts && vite-node scripts/simulate-trail.ts && vite-node scripts/simulate-route.ts",
    "verify": "npm test && npm run simulate && npm run build",
    "import:effects": "node scripts/import-effects.mjs",
    "import:items": "node scripts/import-items.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.3.1",
    "vite-node": "^3.2.4",
    "vitest": "^3.0.0"
  }
}
